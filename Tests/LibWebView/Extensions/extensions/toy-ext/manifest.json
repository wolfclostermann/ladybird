{
  // Comments are allowed, as in Chromium.
  "manifest_version": 3,
  "name": "Toy",
  "version": "0.1",
  "permissions": ["storage", "scripting", "webNavigation", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "bg.js", "type": "module" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["start.js"], "css": ["toy.css"], "run_at": "document_start", "all_frames": true },
    { "matches": ["<all_urls>"], "js": ["end.js"], "run_at": "document_end" },
    { "matches": ["<all_urls>"], "js": ["idle.js"] }
  ]
}
